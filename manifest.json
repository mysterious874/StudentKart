{
  "name": "GlobeDisc",
  "short_name": "GlobeDisc",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "background_color": "#102a43",
