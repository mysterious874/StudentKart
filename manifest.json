{
  "name": "Banjara Connect",
  "short_name": "Connect",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "background_color": "#fbf4e8",
